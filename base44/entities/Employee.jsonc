{
  "name": "Employee",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "full_name_ar": {
      "type": "string"
    },
    "full_name_en": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "employee_id": {
      "type": "number"
    },
    "job_title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "shift": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "manager": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "national_id": {
      "type": "string"
    },
    "id_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "passport_number": {
      "type": "string"
    },
    "passport_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "divorced"
      ]
    },
    "address": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "salary": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_leave",
        "inactive"
      ],
      "default": "active"
    },
    "avatar_url": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "leave_policy": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "job_title",
    "department"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}