{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "request_category": {
      "type": "string",
      "enum": [
        "leave",
        "attendance_correction",
        "permission",
        "business_trip",
        "loan"
      ],
      "default": "leave"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "annual",
        "sick",
        "unpaid",
        "emergency"
      ],
      "default": "annual"
    },
    "leave_subtype": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "review_note": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "request_category",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}