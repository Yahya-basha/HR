{
  "name": "EmploymentContract",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "limited",
        "fixed",
        "undefined"
      ],
      "default": "limited"
    },
    "joining_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "probation_days": {
      "type": "number",
      "default": 90
    },
    "probation_end_date": {
      "type": "string",
      "format": "date"
    },
    "basic_salary": {
      "type": "number"
    },
    "working_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "terminated"
      ],
      "default": "active"
    }
  },
  "required": [
    "employee_name",
    "company",
    "contract_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}