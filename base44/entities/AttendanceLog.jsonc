{
  "name": "AttendanceLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "check_in": {
      "type": "string",
      "format": "date-time"
    },
    "check_out": {
      "type": "string",
      "format": "date-time"
    },
    "check_in_method": {
      "type": "string",
      "enum": [
        "biometric",
        "app",
        "manual"
      ],
      "default": "app"
    },
    "check_out_method": {
      "type": "string",
      "enum": [
        "biometric",
        "app",
        "manual"
      ]
    },
    "shift_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "late",
        "absent"
      ],
      "default": "present"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "log_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}