{
  "name": "LeavePolicy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "annual_days": {
      "type": "number",
      "default": 21
    },
    "sick_days": {
      "type": "number",
      "default": 30
    },
    "emergency_days": {
      "type": "number",
      "default": 5
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "annual_days"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}