{
  "name": "M07 Expiry Alerts",
  "description": "Daily scan for soon-to-expire national IDs, passports, and employment contracts; emails admins a consolidated alert",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "m07_expiry_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_and_notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "m07Alerts",
            "args": {
              "id_days": 30,
              "passport_days": 60,
              "contract_days": 60,
              "probation_days": 30
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0641\u062d\u0635 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621\u0627\u062a \u0648\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a",
            "description": "\u0645\u062d\u0631\u0643 M07 \u0644\u0644\u062a\u0646\u0628\u064a\u0647\u0627\u062a"
          }
        }
      }
    ]
  }
}